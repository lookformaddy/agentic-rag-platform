# Agentic RAG Platform — environment template
# Copy to .env and adjust. No secrets are needed: retrieval, generation
# and tools are deterministic and simulated, so the platform runs fully
# offline.
ARP_EMBEDDING_DIM=128
ARP_DEFAULT_TOP_K=5
ARP_DEFAULT_VECTOR_WEIGHT=0.5
ARP_DEFAULT_MAX_ROUNDS=3
ARP_DEFAULT_MAX_SUBQUERIES=4
ARP_SUFFICIENCY_THRESHOLD=0.30
ARP_ABSTAIN_THRESHOLD=0.25
ARP_MIN_EVIDENCE_SCORE=0.20
ARP_REFERENCE_DATE=2026-11-17
ARP_TOOL_TIMEOUT_MS=2000
ARP_COST_PER_1K_TOKENS=0.002
ARP_COST_PER_TOOL_CALL=0.0005
ARP_COST_PER_RETRIEVAL_ROUND=0.0002
ARP_TENANT_COST_CAP_USD=1.00
ARP_TENANT_REQUEST_CAP=1000
ARP_TENANT_TOKEN_CAP=1000000
ARP_SEED=42
ARP_HOST=0.0.0.0
ARP_PORT=8000
